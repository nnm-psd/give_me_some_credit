.venv/
__pycache__/
*.pyc
.pytest_cache/

# Raw data is licensed/large — never committed
data/raw/
data/processed/

# Trained artifacts are regenerated by src/pipeline/train.py — not committed
# by default. Exception: models/give-me-some-credit/ IS committed (see the
# negations below) — Streamlit Community Cloud has no raw data and no
# training step at deploy time, so the app's non-Data-Overview pages need
# these small, derived artifacts (bins/coefficients/metrics, not raw
# records) to be in the repo. This is a deliberate, narrow exception, not a
# reversal of the general rule.
models/**/*.pkl
models/**/*.joblib
models/**/*.json
!models/give-me-some-credit/*.pkl
!models/give-me-some-credit/*.json

.ipynb_checkpoints/

# Personal interview-prep documents — generated locally, deliberately not
# committed (per user request). HTML sources kept alongside for regenerating
# the PDF later (open in a browser and print, or headless-print to PDF).
docs/project-overview-vi.pdf
docs/project-overview-en.pdf
docs/project-overview-vi.html
docs/project-overview-en.html
